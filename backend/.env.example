# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/hrms_payroll"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="8h"

# Server
PORT=5000
NODE_ENV=development

# CORS
FRONTEND_URL="http://localhost:5173"

# Default admin (used only by the seed script on first run)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="admin123"

# File storage (generated salary slip PDFs)
UPLOADS_DIR="./uploads"

# Backups (npm run backup / npm run restore)
BACKUPS_DIR="./backups"
BACKUP_RETENTION_COUNT=14

# Email notifications (payslip emailing, birthday greetings)
# Leave these blank to keep email notifications disabled — the app runs
# fine without them, this feature is entirely opt-in.
# Example for Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, and an
# "App Password" (not your normal Gmail password) for SMTP_PASS.
# Example for SendGrid: SMTP_HOST="smtp.sendgrid.net", SMTP_PORT=587,
# SMTP_USER="apikey", SMTP_PASS="<your SendGrid API key>".
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# SMS notifications via MSG91 (birthday greetings) — also opt-in, leave
# blank to keep SMS disabled. Sign up at https://msg91.com, get an auth
# key and a registered sender ID (6 characters, DLT-registered for India).
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
